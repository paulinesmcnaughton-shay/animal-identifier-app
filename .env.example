# Supabase — publishable key is safe in the app; never ship SUPABASE_SECRET_KEY to the client
SUPABASE_URL=https://wiysesftlprovkpouvqu.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

MAPBOX_ACCESS_TOKEN=
# JWT from https://www.inaturalist.org/users/api_token (logged in). Expires ~24h — refresh daily.
INATURALIST_API_TOKEN=
# Anthropic — Claude Vision for breed + wild backup (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
# Google Cloud Vision — fast category routing (dog, bird, insect, etc.)
GOOGLE_VISION_API_KEY=
# Google Programmable Search — reference-image fallback (large image database).
# GOOGLE_SEARCH_API_KEY: a Google API key with the Custom Search API enabled
#   (reuse GOOGLE_VISION_API_KEY if Custom Search is enabled on that key).
# GOOGLE_SEARCH_CX: Programmable Search Engine ID from programmablesearchengine.google.com
#   (create an engine, enable "Image search" + "Search the entire web").
# Without GOOGLE_SEARCH_CX the Google rung is skipped (iNat/Wikipedia only).
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
# Optional: OAuth access token auto-refreshes JWT (see iNaturalist API docs)
INATURALIST_OAUTH_TOKEN=
